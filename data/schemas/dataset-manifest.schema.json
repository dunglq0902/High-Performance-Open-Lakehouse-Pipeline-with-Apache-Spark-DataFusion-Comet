{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lakehouse-comet:dataset-manifest:v1",
  "title": "Immutable generated dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "generator",
    "seed",
    "scale_profile",
    "skew_profile",
    "benchmark_eligible",
    "timezone",
    "currency",
    "rounding_mode",
    "generation_config_sha256",
    "profile",
    "content_hash_contract",
    "storage",
    "tables"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"benchmark_eligible": {"const": true}},
        "required": ["benchmark_eligible"]
      },
      "then": {
        "properties": {
          "generator": {
            "required": [
              "name",
              "version",
              "git_commit",
              "worktree_dirty",
              "python_version",
              "python_implementation"
            ],
            "properties": {
              "worktree_dirty": {"const": false}
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit", "worktree_dirty"],
      "properties": {
        "name": {"const": "data.generator"},
        "version": {"const": "1.0.0"},
        "git_commit": {"type": "string", "minLength": 1},
        "worktree_dirty": {"type": "boolean"},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "python_implementation": {"const": "CPython"}
      }
    },
    "seed": {"type": "integer", "minimum": 0},
    "scale_profile": {"type": "string", "minLength": 1},
    "skew_profile": {"const": "uniform"},
    "benchmark_eligible": {"type": "boolean"},
    "timezone": {"const": "UTC"},
    "currency": {"const": "USD"},
    "rounding_mode": {"const": "HALF_UP"},
    "generation_config_sha256": {"$ref": "#/$defs/sha256"},
    "profile": {"$ref": "urn:lakehouse-comet:generator-profile:v1"},
    "content_hash_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonical_row_encoding", "primary_key_range_size"],
      "properties": {
        "algorithm": {"const": "sha256-merkle-pk-range-v1"},
        "canonical_row_encoding": {"const": "length-prefixed-arrow-scalars-v1"},
        "primary_key_range_size": {"const": 10000}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "compression", "pyarrow_version"],
      "properties": {
        "format": {"const": "parquet"},
        "compression": {"const": "snappy"},
        "pyarrow_version": {"type": "string", "minLength": 1}
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customers", "products", "orders", "order_items", "events"],
      "properties": {
        "customers": {"$ref": "#/$defs/table"},
        "products": {"$ref": "#/$defs/table"},
        "orders": {"$ref": "#/$defs/table"},
        "order_items": {"$ref": "#/$defs/table"},
        "events": {"$ref": "#/$defs/table"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rangeHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range_start", "range_end", "row_count", "sha256"],
      "properties": {
        "range_start": {"type": "integer", "minimum": 1},
        "range_end": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "row_count", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^/]+/part-[0-9]{5}\\.parquet$"},
        "row_count": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "schema_sha256",
        "row_count",
        "content_sha256",
        "content_hash_algorithm",
        "canonical_row_encoding",
        "primary_key_range_size",
        "range_key",
        "range_hashes",
        "min_max",
        "null_counts",
        "format",
        "compression",
        "file_count",
        "total_bytes",
        "files"
      ],
      "properties": {
        "primary_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "content_hash_algorithm": {"const": "sha256-merkle-pk-range-v1"},
        "canonical_row_encoding": {"const": "length-prefixed-arrow-scalars-v1"},
        "primary_key_range_size": {"const": 10000},
        "range_key": {"type": "string", "minLength": 1},
        "range_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rangeHash"}
        },
        "min_max": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": ["integer", "string", "null"]}
          }
        },
        "null_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "format": {"const": "parquet"},
        "compression": {"const": "snappy"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  }
}
