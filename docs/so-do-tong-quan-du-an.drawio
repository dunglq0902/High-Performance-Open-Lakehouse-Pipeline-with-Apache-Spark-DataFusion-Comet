        <mxCell id="stage6" value="&lt;b&gt;6. VERIFY + ARTIFACTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cùng snapshot • schema hash bằng nhau&lt;br&gt;row count + result hash bằng nhau&lt;br&gt;Comet có native operator&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6d28d9&quot;&gt;result JSON • initial/final plans&lt;br&gt;runtime fingerprint • logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=10;" vertex="1" parent="1">
