        <mxCell id="compare-title" value="&lt;b&gt;5. CÙNG M02, HAI ENGINE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1">
