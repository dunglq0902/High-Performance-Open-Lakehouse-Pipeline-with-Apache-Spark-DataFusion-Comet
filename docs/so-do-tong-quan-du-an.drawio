        <mxCell id="title" value="&lt;b&gt;TỔNG QUAN LUỒNG DỮ LIỆU VÀ SO SÁNH SPARK — COMET&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1540" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Readiness smoke M02 trên MinIO + Apache Iceberg — cùng dữ liệu, cùng snapshot, cùng SQL" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="340" y="65" width="1220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="current-label" value="&lt;b&gt;LUỒNG HIỆN TẠI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="190" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="current-note" value="Fixture và diagnostic wall time chỉ là readiness evidence, không phải kết quả benchmark nghiên cứu." style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="1120" y="115" width="720" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="stage1" value="&lt;b&gt;1. SINH DỮ LIỆU&lt;/b&gt;&lt;br&gt;&lt;br&gt;Synthetic E-commerce generator&lt;br&gt;5 bảng nguồn&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;deterministic • seed • schema contract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="210" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="stage2" value="&lt;b&gt;2. SOURCE FILES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sorted Snappy Parquet&lt;br&gt;Dataset manifest JSON&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;schema/content/file SHA-256&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;fixture: 96 orders&lt;/font&gt;" style="shape=folder;tabWidth=60;tabHeight=18;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=14;spacingTop=14;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="190" width="210" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="stage3" value="&lt;b&gt;3. SPARK PREPARE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc + validate source Parquet&lt;br&gt;Ghi bảng Iceberg v2&lt;br&gt;Lấy snapshot_id&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;nằm ngoài measurement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#0f172a;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="190" width="220" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="stage4" value="&lt;b&gt;4. OPEN LAKEHOUSE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Iceberg table:&lt;/b&gt; lakehouse.bronze.orders&lt;br&gt;&lt;b&gt;Data files:&lt;/b&gt; Parquet trên MinIO&lt;br&gt;&lt;b&gt;Catalog:&lt;/b&gt; Iceberg REST + SQLite&lt;br&gt;&lt;b&gt;Read identity:&lt;/b&gt; snapshot_id&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;MinIO lưu bytes • Iceberg quản lý table/version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="175" width="255" height="185" as="geometry"/>
        </mxCell>

