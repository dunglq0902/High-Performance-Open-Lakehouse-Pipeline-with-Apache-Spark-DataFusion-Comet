        <mxCell id="baseline" value="&lt;b&gt;A. Spark baseline&lt;/b&gt;&lt;br&gt;Spark JVM operators&lt;br&gt;không nạp Comet plugin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
