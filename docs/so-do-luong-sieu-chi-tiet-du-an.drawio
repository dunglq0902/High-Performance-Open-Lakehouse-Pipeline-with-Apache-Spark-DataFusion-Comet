        <mxCell id="lane-orchestrator" value="A  HOST / PYTHON ORCHESTRATOR" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontStyle=1;fontSize=13;swimlaneFillColor=#e2e8f0;" vertex="1" parent="1">
