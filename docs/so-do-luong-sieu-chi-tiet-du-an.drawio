        <mxCell id="title" value="&lt;b&gt;LUỒNG SIÊU CHI TIẾT — READINESS SMOKE M02, ICEBERG, SPARK BASELINE VÀ COMET&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Đường liền: đã có trong code/config • Đường nét đứt: protocol nghiên cứu chưa triển khai đầy đủ&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#0f172a;" vertex="1" parent="1">
