        <mxCell id="lane-spark" value="B  SPARK CLUSTER + PREPARE APP" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontStyle=1;fontSize=13;swimlaneFillColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="490" height="1440" as="geometry"/>
        </mxCell>
        <mxCell id="lane-storage" value="C  MINIO + ICEBERG CATALOG / TABLE" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontStyle=1;fontSize=13;swimlaneFillColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1015" y="120" width="500" height="1440" as="geometry"/>
        </mxCell>
        <mxCell id="lane-baseline" value="D  ENGINE A — SPARK BASELINE" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontStyle=1;fontSize=13;swimlaneFillColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1530" y="120" width="410" height="1440" as="geometry"/>
        </mxCell>
        <mxCell id="lane-comet" value="E  ENGINE B — SPARK + DATAFUSION COMET" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;arcSize=6;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontStyle=1;fontSize=13;swimlaneFillColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1955" y="120" width="620" height="1440" as="geometry"/>
        </mxCell>

        <mxCell id="a1-env" value="&lt;b&gt;A1. bootstrap_env.py&lt;/b&gt;&lt;br&gt;Tạo/giữ `.env` local&lt;br&gt;MINIO user/password • JDBC password • region&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;không in hoặc thay secret đã có&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="165" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a2-fixture" value="&lt;b&gt;A2. ensure_fixture.py&lt;/b&gt;&lt;br&gt;Sinh/validate deterministic E-commerce fixture&lt;br&gt;5 bảng → sorted Snappy Parquet&lt;br&gt;manifest.json bất biến; seed=42; eligible=false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="270" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a3-validate" value="&lt;b&gt;A3. lakehouse-bench validate&lt;/b&gt;&lt;br&gt;JSON Schema + duplicate YAML key check&lt;br&gt;runtime lock • data contract • SQL binding&lt;br&gt;common SparkConf = spark-defaults.conf" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="380" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a4-plan" value="&lt;b&gt;A4. lakehouse-bench plan&lt;/b&gt;&lt;br&gt;Resolve config → redact secrets → hash inputs&lt;br&gt;tạo immutable experiment manifest&lt;br&gt;lập lịch paired randomized AB/BA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="490" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a5-compose" value="&lt;b&gt;A5. docker compose up --build&lt;/b&gt;&lt;br&gt;minio → minio-init → iceberg-rest&lt;br&gt;spark-master → spark-worker&lt;br&gt;network lakehouse + persistent volumes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="600" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a6-health" value="&lt;b&gt;A6. Readiness waits&lt;/b&gt;&lt;br&gt;MinIO healthy • init completed&lt;br&gt;REST healthy • master/worker healthy&lt;br&gt;terminal failure → collect compose logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="710" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a7-images" value="&lt;b&gt;A7. Capture local image IDs&lt;/b&gt;&lt;br&gt;Spark • MinIO • Iceberg REST&lt;br&gt;ghi container-images.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="815" width="370" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="a8-snapshot" value="&lt;b&gt;A8. Đọc iceberg-prepare.json&lt;/b&gt;&lt;br&gt;Lấy snapshot_id duy nhất&lt;br&gt;truyền cùng ID vào cả hai engine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="1010" width="370" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a9-contract" value="&lt;b&gt;A9. M02 workload contract&lt;/b&gt;&lt;br&gt;storage=ecommerce_iceberg_rest&lt;br&gt;table=lakehouse.bronze.orders&lt;br&gt;typed params: start/end UTC + bucket 10&lt;br&gt;expected schema SHA-256 • result_mode=collect" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="1110" width="370" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a10-launch" value="&lt;b&gt;A10. Chạy tuần tự hai fresh apps&lt;/b&gt;&lt;br&gt;1) spark_baseline&lt;br&gt;2) comet_accelerated + comet.properties&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;mỗi app dùng cùng snapshot + SQL bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="75" y="1245" width="370" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="b1-cluster" value="&lt;b&gt;B1. Spark Standalone cluster&lt;/b&gt;&lt;br&gt;spark-client: driver / spark-submit&lt;br&gt;master :7077 → worker → 1 executor&lt;br&gt;2 cores • heap 2g • overhead 1g • off-heap 1g" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="165" width="400" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="b2-prepare" value="&lt;b&gt;B2. spark-submit prepare_iceberg.py&lt;/b&gt;&lt;br&gt;Fresh Spark baseline application&lt;br&gt;prepare nằm ngoài measured query boundary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="300" width="400" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="b3-fingerprint" value="&lt;b&gt;B3. Runtime fingerprint gate&lt;/b&gt;&lt;br&gt;Spark 4.1.3 • Scala 2.13.17 • Java 17.0.19+10&lt;br&gt;Python 3.12.13 • Iceberg 1.11.0&lt;br&gt;JAR SHA-256 + one class origin + no S3A class&lt;br&gt;baseline phải không nạp Comet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="405" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b4-source" value="&lt;b&gt;B4. Resolve source from dataset manifest&lt;/b&gt;&lt;br&gt;chỉ nhận relative `.parquet` nằm dưới immutable root&lt;br&gt;không path traversal • file phải tồn tại&lt;br&gt;đọc explicit orders schema" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="545" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b5-data-gate" value="&lt;b&gt;B5. Required-field gate&lt;/b&gt;&lt;br&gt;order_id/customer_id/order_time/status/payment_method NOT NULL&lt;br&gt;rebuild DataFrame schema để giữ nullability contract&lt;br&gt;từ chối persisted NullType" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="665" width="400" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="b6-write" value="&lt;b&gt;B6. Tạo Iceberg table&lt;/b&gt;&lt;br&gt;CREATE NAMESPACE lakehouse.bronze&lt;br&gt;writeTo(lakehouse.bronze.orders)&lt;br&gt;USING iceberg • format-version=2 • Snappy&lt;br&gt;createOrReplace() → atomic metadata commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="790" width="400" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="b7-snapshot-query" value="&lt;b&gt;B7. Snapshot + row-count verification&lt;/b&gt;&lt;br&gt;SELECT snapshot_id, manifest_list FROM table.snapshots&lt;br&gt;ORDER BY committed_at DESC LIMIT 1&lt;br&gt;Iceberg row_count phải bằng dataset manifest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="925" width="400" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="b8-prepare-artifact" value="&lt;b&gt;B8. iceberg-prepare.json&lt;/b&gt;&lt;br&gt;runtime fingerprint • dataset manifest hash&lt;br&gt;table • row_count • snapshot_id • manifest_list&lt;br&gt;canonical JSON; immutable write" style="shape=folder;tabWidth=70;tabHeight=18;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="555" y="1050" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b9-common-conf" value="&lt;b&gt;B9. Common comparison envelope&lt;/b&gt;&lt;br&gt;AQE=true • ANSI=true • timezone=UTC&lt;br&gt;shuffle partitions=8 • speculation=false&lt;br&gt;Iceberg REST catalog + S3FileIO/MinIO endpoint&lt;br&gt;event log enabled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="555" y="1190" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b10-snapshot-branch" value="&lt;b&gt;B10. Cùng immutable comparison identity&lt;/b&gt;&lt;br&gt;snapshot ID + dataset/workload/SQL hashes + common SparkConf" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="1340" width="330" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="c1-minio" value="&lt;b&gt;C1. MinIO service&lt;/b&gt;&lt;br&gt;S3 API :9000 • console :9001&lt;br&gt;source-built pinned tag&lt;br&gt;volume minio-data" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1045" y="165" width="205" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c2-rest" value="&lt;b&gt;C2. Iceberg REST service&lt;/b&gt;&lt;br&gt;REST API :8181&lt;br&gt;JdbcCatalog + SQLite&lt;br&gt;volume iceberg-catalog" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1270" y="165" width="215" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c3-bucket" value="&lt;b&gt;C3. minio-init&lt;/b&gt;&lt;br&gt;mc ready → create private bucket `lakehouse`&lt;br&gt;anonymous access = none" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1045" y="310" width="205" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c4-sqlite" value="&lt;b&gt;C4. Catalog database&lt;/b&gt;&lt;br&gt;iceberg_catalog.db&lt;br&gt;giữ catalog records / metadata pointer" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=12;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry x="1270" y="310" width="215" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c5-s3fileio" value="&lt;b&gt;C5. Iceberg S3FileIO&lt;/b&gt;&lt;br&gt;endpoint http://minio:9000&lt;br&gt;path-style=true • region us-east-1&lt;br&gt;AWS SDK bundle; không dùng Hadoop S3A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1045" y="425" width="205" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c6-catalog-api" value="&lt;b&gt;C6. Catalog operations&lt;/b&gt;&lt;br&gt;namespace/table lookup&lt;br&gt;current metadata location&lt;br&gt;optimistic/atomic commit qua REST" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1270" y="425" width="215" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c7-table" value="&lt;b&gt;C7. Table identifier&lt;/b&gt;&lt;br&gt;catalog: lakehouse&lt;br&gt;namespace: bronze&lt;br&gt;table: orders&lt;br&gt;warehouse: s3://lakehouse/warehouse" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1090" y="570" width="350" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="c8-metadata" value="&lt;b&gt;C8. Metadata JSON&lt;/b&gt;&lt;br&gt;schema(s) • table properties&lt;br&gt;partition spec(s) • snapshot history" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1090" y="715" width="350" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c9-snapshot" value="&lt;b&gt;C9. Snapshot&lt;/b&gt;&lt;br&gt;immutable logical table version&lt;br&gt;snapshot_id dùng để pin read" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1090" y="825" width="350" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c10-manifest-list" value="&lt;b&gt;C10. Manifest list&lt;/b&gt;&lt;br&gt;liệt kê manifest files của snapshot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1090" y="930" width="350" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c11-manifests" value="&lt;b&gt;C11. Iceberg manifests&lt;/b&gt;&lt;br&gt;data-file entries + partition/statistics&lt;br&gt;không phải dataset/workload manifest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1025" width="350" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c12-datafiles" value="&lt;b&gt;C12. Parquet data files&lt;/b&gt;&lt;br&gt;Snappy • columnar • Iceberg-owned objects&lt;br&gt;fixture write hiện không khai báo partition&lt;br&gt;format v2 nhưng chưa có delete files" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1130" width="350" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="c13-read-planning" value="&lt;b&gt;C13. Snapshot-pinned scan planning&lt;/b&gt;&lt;br&gt;Catalog → metadata → snapshot → manifests&lt;br&gt;prune files/columns/predicates khi có thể&lt;br&gt;trả scan tasks cho Spark/Comet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1280" width="350" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="d1-app" value="&lt;b&gt;D1. Fresh baseline Spark app&lt;/b&gt;&lt;br&gt;run_workload.py --engine spark_baseline&lt;br&gt;không `--conf` Comet" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1560" y="635" width="350" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="d2-runtime" value="&lt;b&gt;D2. Baseline runtime gate&lt;/b&gt;&lt;br&gt;spark.plugins phải rỗng&lt;br&gt;spark.comet.version phải không tồn tại&lt;br&gt;runtime/JAR/classpath khớp lock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
