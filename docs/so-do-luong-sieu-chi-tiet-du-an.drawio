        <mxCell id="d3-bind" value="&lt;b&gt;D3. Bind Iceberg snapshot&lt;/b&gt;&lt;br&gt;format=iceberg • option snapshot-id&lt;br&gt;validate required columns/type/nullability&lt;br&gt;createOrReplaceTempView(bench_orders)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=13;spacing=7;" vertex="1" parent="1">
