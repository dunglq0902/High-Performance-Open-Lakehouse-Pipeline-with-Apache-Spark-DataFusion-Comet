.env
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Generated data and benchmark artifacts are immutable but not committed by default.
data/generated/
data/manifests/generated/
results/raw/*
results/normalized/*
results/reports/*
!results/raw/.gitkeep
!results/normalized/.gitkeep
!results/reports/.gitkeep
analysis/plots/*
!analysis/plots/.gitkeep
spark-events/*

# Generated presentation binaries are rebuilt from the admitted report evidence.
deliverables/presentation/*.pptx
deliverables/presentation/*.manifest.json

# Recorded demo media and its evidence-bound sidecar are generated after final campaigns.
deliverables/video/*.mp4
deliverables/video/*.manifest.json

# Final ZIP64 release and its outer checksum are generated from publishable evidence.
deliverables/release/*.zip
deliverables/release/*.zip.sha256

# Local runtime state.
.runtime/
.artifacts/
warehouse/
metastore/
