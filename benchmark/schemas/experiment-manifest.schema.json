{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/lakehouse/schemas/experiment-manifest-v1.json",
  "title": "Immutable dry-run experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "protocol", "resolved_config", "schedule", "input_hashes", "manifest_sha256", "readiness"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string"},
    "protocol": {"const": "paired-randomized-ab-ba-v1"},
    "resolved_config": {"type": "object"},
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_index", "order"],
        "properties": {
          "pair_index": {"type": "integer", "minimum": 1},
          "order": {
            "type": "array",
            "prefixItems": [{"type": "string"}, {"type": "string"}],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_config_sha256", "runtime_lock_sha256", "workload_sql_sha256", "workload_manifest_sha256", "dataset_manifest_sha256", "uv_lock_sha256", "spark_defaults_sha256", "comet_profile_sha256"],
      "properties": {
        "experiment_config_sha256": {"$ref": "#/$defs/hash"},
        "runtime_lock_sha256": {"$ref": "#/$defs/hash"},
        "workload_sql_sha256": {"$ref": "#/$defs/hash"},
        "workload_manifest_sha256": {"$ref": "#/$defs/hash"},
        "dataset_manifest_sha256": {"$ref": "#/$defs/hash"},
        "uv_lock_sha256": {"$ref": "#/$defs/hash"},
        "spark_defaults_sha256": {"$ref": "#/$defs/hash"},
        "comet_profile_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_services", "native_library", "runtime_versions", "dataset_content"],
      "properties": {
        "docker_services": {"type": "string"},
        "native_library": {"type": "string"},
        "runtime_versions": {"type": "string"},
        "dataset_content": {"type": "string"}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
