{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/lakehouse/schemas/dataset-validation-attestation-v1.json",
  "title": "Content-bound dataset validation attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "schema_version",
    "status",
    "dataset",
    "validator",
    "runtime_parquet_inventory",
    "attestation_sha256"
  ],
  "properties": {
    "artifact_class": {"const": "dataset-validation-attestation-v1"},
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "dataset_id",
        "manifest_path",
        "manifest_sha256",
        "content_identity_sha256"
      ],
      "properties": {
        "suite": {"enum": ["ecommerce", "tpch"]},
        "dataset_id": {"type": "string", "minLength": 1},
        "manifest_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/manifest\\.json$"
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "content_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "expected_python_version",
        "python_implementation",
        "python_version",
        "pyarrow_version",
        "runtime_lock_sha256",
        "result_sha256"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_python_version": {"$ref": "#/$defs/pythonVersion"},
        "python_implementation": {"const": "CPython"},
        "python_version": {"$ref": "#/$defs/pythonVersion"},
        "pyarrow_version": {"type": "string", "minLength": 1},
        "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {
          "description": "Canonical semantic validation result hash; excludes local filesystem paths.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime_parquet_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "path", "row_count", "size_bytes", "sha256"],
        "properties": {
          "table": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.parquet$"
          },
          "row_count": {"type": "integer", "minimum": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "attestation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pythonVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}
