{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/lakehouse/schemas/raw-result-v1.json",
  "title": "Immutable benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "run_id", "pair_index", "phase", "timestamp", "status",
    "failure", "engine", "workload", "query_id", "storage_profile", "provenance", "runtime",
    "resources", "metrics", "plan_analysis", "correctness", "artifacts"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric": {"type": ["number", "null"], "minimum": 0},
    "artifact": {"type": ["string", "null"], "minLength": 1}
  },
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "pair_index": {"type": ["integer", "null"], "minimum": 1},
    "phase": {"enum": ["correctness", "plan_capture", "measurement"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "status": {"enum": ["succeeded", "failed", "timeout", "invalid_result", "invalid_environment"]},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "message"],
          "properties": {
            "class": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "engine": {"enum": ["spark_baseline", "comet_accelerated"]},
    "workload": {"enum": ["micro", "business", "tpch"]},
    "query_id": {"type": "string", "pattern": "^[MBQ][0-9]{2}$"},
    "storage_profile": {"type": "string", "minLength": 1},
    "scale_factor": {"type": "integer", "enum": [1, 10]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit", "container_image_digest", "dataset_manifest_sha256",
        "spark_conf_sha256", "sql_sha256", "iceberg_snapshot_ids"
      ],
      "properties": {
        "git_commit": {"type": "string", "minLength": 7},
        "container_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "spark_conf_sha256": {"$ref": "#/$defs/sha256"},
        "sql_sha256": {"$ref": "#/$defs/sha256"},
        "iceberg_snapshot_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spark_version", "scala_version", "java_version", "comet_version", "iceberg_version"],
      "properties": {
        "spark_version": {"type": "string", "minLength": 1},
        "scala_version": {"type": "string", "minLength": 1},
        "java_version": {"type": "string", "minLength": 1},
        "comet_version": {"type": ["string", "null"]},
        "iceberg_version": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_model", "allocated_cores", "cgroup_memory_limit_mib", "executor_heap_mib", "off_heap_mib"],
      "properties": {
        "cpu_model": {"type": "string", "minLength": 1},
        "allocated_cores": {"type": "integer", "minimum": 1},
        "cgroup_memory_limit_mib": {"type": "integer", "minimum": 1},
        "executor_heap_mib": {"type": "integer", "minimum": 1},
        "off_heap_mib": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sql_execution_id", "query_wall_time_ms", "sql_execution_time_ms", "cpu_core_seconds",
        "cpu_peak_percent_of_limit", "cgroup_memory_peak_mib", "jvm_gc_time_ms",
        "shuffle_read_mb", "shuffle_write_mb", "disk_spill_mb", "collector_status"
      ],
      "properties": {
        "sql_execution_id": {"type": ["integer", "null"], "minimum": 0},
        "query_wall_time_ms": {"$ref": "#/$defs/metric"},
        "sql_execution_time_ms": {"$ref": "#/$defs/metric"},
        "cpu_core_seconds": {"$ref": "#/$defs/metric"},
        "cpu_peak_percent_of_limit": {"$ref": "#/$defs/metric"},
        "cgroup_memory_peak_mib": {"$ref": "#/$defs/metric"},
        "jvm_gc_time_ms": {"$ref": "#/$defs/metric"},
        "shuffle_read_mb": {"$ref": "#/$defs/metric"},
        "shuffle_write_mb": {"$ref": "#/$defs/metric"},
        "disk_spill_mb": {"$ref": "#/$defs/metric"},
        "collector_status": {"enum": ["complete", "partial", "unavailable"]}
      }
    },
    "plan_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "total_operators", "comet_native_operators", "spark_fallback_operators",
        "transition_count", "native_subtree_count", "native_coverage_ratio", "fallback_reasons",
        "unknown_nodes", "scan_implementations"
      ],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "total_operators": {"type": "integer", "minimum": 0},
        "comet_native_operators": {"type": "integer", "minimum": 0},
        "spark_fallback_operators": {"type": "integer", "minimum": 0},
        "transition_count": {"type": "integer", "minimum": 0},
        "native_subtree_count": {"type": "integer", "minimum": 0},
        "native_coverage_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "fallback_reasons": {"type": "array", "items": {"type": "string"}},
        "unknown_nodes": {"type": "array", "items": {"type": "string"}},
        "scan_implementations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schema_sha256", "row_count", "canonical_result_sha256"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not_checked"]},
        "schema_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "canonical_result_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_log", "physical_plan", "resource_samples", "stdout", "stderr"],
      "properties": {
        "event_log": {"$ref": "#/$defs/artifact"},
        "physical_plan": {"$ref": "#/$defs/artifact"},
        "resource_samples": {"$ref": "#/$defs/artifact"},
        "stdout": {"$ref": "#/$defs/artifact"},
        "stderr": {"$ref": "#/$defs/artifact"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "measurement"}}},
      "then": {"properties": {"pair_index": {"type": "integer", "minimum": 1}}},
      "else": {"properties": {"pair_index": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "failure": {"type": "null"},
          "metrics": {
            "properties": {
              "sql_execution_id": {"type": "integer", "minimum": 0},
              "query_wall_time_ms": {"type": "number", "exclusiveMinimum": 0},
              "sql_execution_time_ms": {"type": "number", "minimum": 0}
            }
          },
          "correctness": {
            "properties": {
              "status": {"const": "passed"},
              "schema_sha256": {"$ref": "#/$defs/sha256"},
              "row_count": {"type": "integer", "minimum": 0},
              "canonical_result_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      },
      "else": {"properties": {"failure": {"type": "object"}}}
    }
  ]
}
