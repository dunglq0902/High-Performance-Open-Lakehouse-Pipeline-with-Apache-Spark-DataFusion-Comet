{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/lakehouse/schemas/dataset-validation-attestation-v2.json",
  "title": "Content-bound dataset validation attestation with semantic lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_class",
    "schema_version",
    "status",
    "dataset",
    "validator",
    "validation",
    "runtime_parquet_inventory",
    "runtime_source_inventory",
    "attestation_sha256"
  ],
  "properties": {
    "artifact_class": {"const": "dataset-validation-attestation-v2"},
    "schema_version": {"const": 2},
    "status": {"const": "passed"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "validator": {"$ref": "#/$defs/validator"},
    "validation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "semantic_tree"],
          "properties": {
            "mode": {"const": "full"},
            "semantic_tree": {"$ref": "#/$defs/semanticTree"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "semantic_tree", "origin"],
          "properties": {
            "mode": {"const": "rebound"},
            "semantic_tree": {"$ref": "#/$defs/semanticTree"},
            "origin": {"$ref": "#/$defs/origin"}
          }
        }
      ]
    },
    "runtime_parquet_inventory": {"$ref": "#/$defs/parquetInventory"},
    "runtime_source_inventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceFile"}
    },
    "attestation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pythonVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "dataset_id",
        "manifest_path",
        "manifest_sha256",
        "content_identity_sha256"
      ],
      "properties": {
        "suite": {"enum": ["ecommerce", "tpch"]},
        "dataset_id": {"type": "string", "minLength": 1},
        "manifest_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+/manifest\\.json$"
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "content_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "expected_python_version",
        "python_implementation",
        "python_version",
        "pyarrow_version",
        "runtime_lock_sha256",
        "result_sha256"
      ],
      "properties": {
        "git_commit": {"$ref": "#/$defs/gitObject"},
        "expected_python_version": {"$ref": "#/$defs/pythonVersion"},
        "python_implementation": {"const": "CPython"},
        "python_version": {"$ref": "#/$defs/pythonVersion"},
        "pyarrow_version": {"type": "string", "minLength": 1},
        "runtime_lock_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semanticTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "object_id"],
      "properties": {
        "path": {"enum": ["data/generator", "data/tpch"]},
        "object_id": {"$ref": "#/$defs/gitObject"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "schema_version",
        "attestation_path",
        "attestation_file_sha256",
        "attestation_payload_sha256",
        "validator_git_commit",
        "semantic_tree_object_id",
        "manifest_sha256",
        "content_identity_sha256",
        "result_sha256"
      ],
      "properties": {
        "artifact_class": {
          "enum": ["dataset-validation-attestation-v1", "dataset-validation-attestation-v2"]
        },
        "schema_version": {"enum": [1, 2]},
        "attestation_path": {
          "type": "string",
          "pattern": "^\\.artifacts/dataset-validations/[0-9a-f]{40}/[0-9a-f]{64}\\.json$"
        },
        "attestation_file_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_payload_sha256": {"$ref": "#/$defs/sha256"},
        "validator_git_commit": {"$ref": "#/$defs/gitObject"},
        "semantic_tree_object_id": {"$ref": "#/$defs/gitObject"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "content_identity_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "parquetInventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "path", "row_count", "size_bytes", "sha256"],
        "properties": {
          "table": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.parquet$"
          },
          "row_count": {"type": "integer", "minimum": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "path", "size_bytes", "sha256"],
      "properties": {
        "table": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.tbl$"
        },
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
